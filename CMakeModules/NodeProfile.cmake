# Node binaries have two build variants. Operational roles such as BP, RPC,
# and seed are runtime configuration presets, not separate consensus builds.
if(DEFINED FLON_NODE_VARIANT)
  set(_flon_node_variant_explicit TRUE)
else()
  set(_flon_node_variant_explicit FALSE)
endif()
set(FLON_NODE_VARIANT "core" CACHE STRING "Node build variant: core or history")
set_property(CACHE FLON_NODE_VARIANT PROPERTY STRINGS core history)

# One-release compatibility bridge for existing build automation. Do not add
# new role names here; roles belong in config/node/*.ini.
if(DEFINED FLON_NODE_PROFILE AND NOT FLON_NODE_PROFILE STREQUAL "")
  if(FLON_NODE_PROFILE MATCHES "^(full|history)$")
    set(_legacy_variant history)
  elseif(FLON_NODE_PROFILE MATCHES "^(bp|rpc)$")
    set(_legacy_variant core)
  else()
    message(FATAL_ERROR "Invalid legacy FLON_NODE_PROFILE: ${FLON_NODE_PROFILE}")
  endif()
  if(NOT _flon_node_variant_explicit)
    set(FLON_NODE_VARIANT "${_legacy_variant}" CACHE STRING "Node build variant: core or history" FORCE)
    message(DEPRECATION "FLON_NODE_PROFILE=${FLON_NODE_PROFILE} is deprecated; use FLON_NODE_VARIANT=${_legacy_variant} and a runtime config preset")
  else()
    message(DEPRECATION "FLON_NODE_PROFILE=${FLON_NODE_PROFILE} is deprecated and ignored because FLON_NODE_VARIANT=${FLON_NODE_VARIANT} is set")
  endif()
endif()

if(NOT FLON_NODE_VARIANT MATCHES "^(core|history)$")
  message(FATAL_ERROR "Invalid FLON_NODE_VARIANT: ${FLON_NODE_VARIANT}")
endif()

function(flon_variant_feature feature default_value)
  set(FLON_WITH_${feature} "AUTO" CACHE STRING "Build ${feature}: AUTO, ON or OFF")
  set_property(CACHE FLON_WITH_${feature} PROPERTY STRINGS AUTO ON OFF)
  if(FLON_WITH_${feature} STREQUAL "AUTO")
    set(FLON_BUILD_${feature} ${default_value} PARENT_SCOPE)
  elseif(FLON_WITH_${feature} MATCHES "^(ON|OFF)$")
    set(FLON_BUILD_${feature} ${FLON_WITH_${feature}} PARENT_SCOPE)
  else()
    message(FATAL_ERROR "FLON_WITH_${feature} must be AUTO, ON or OFF")
  endif()
endfunction()

set(flon_history_default OFF)
if(FLON_NODE_VARIANT STREQUAL "history")
  set(flon_history_default ON)
endif()
flon_variant_feature(TRANSACTION_HISTORY ${flon_history_default})
flon_variant_feature(STATE_HISTORY ${flon_history_default})
flon_variant_feature(TRACE_API ${flon_history_default})
flon_variant_feature(SIGN_TRANSACTION OFF)
flon_variant_feature(TEST_CONTROL ${BUILD_TESTS})
option(FLON_BUILD_CLIENT_TOOLS "Build and install client, wallet and utility programs" ON)

message(STATUS "FLON variant=${FLON_NODE_VARIANT}; transaction_history=${FLON_BUILD_TRANSACTION_HISTORY}; state_history=${FLON_BUILD_STATE_HISTORY}; trace=${FLON_BUILD_TRACE_API}; signing=${FLON_BUILD_SIGN_TRANSACTION}; test_control=${FLON_BUILD_TEST_CONTROL}")
